# Copy to .env.local for local dev. Never commit real values.
# Local values come from `npm run db:start` output.

# --- Supabase (public: safe in browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SERVER ONLY: never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Absolute site URL used in emails, driver links and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend). If unset, emails are logged to email_log as "skipped". ---
RESEND_API_KEY=
EMAIL_FROM="Order Desk <orders@example.com>"
# Where admin notifications (new registration, new order) are sent.
ADMIN_NOTIFY_EMAIL=

# --- Tests only ---
# Postgres URL for SQL security tests against the local stack.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# PW_CHROMIUM=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
