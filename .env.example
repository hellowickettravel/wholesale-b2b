# Copy to .env.local for local dev. Never commit real values.
# Local values come from `npm run db:start` output.

# --- Supabase (public: safe in browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SERVER ONLY: never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Absolute site URL used in emails, driver links and auth redirects. Set for Production only;
# previews fall back to https://$VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (SMTP: Gmail / Google Workspace or any provider) ---
# If SMTP_HOST is empty nothing is sent: emails wait in the email_log outbox (Admin > Emails shows them).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<the gmail address>, SMTP_PASS=<a Google "app password">.
# Local: Mailpit takes mail on 127.0.0.1:54325 with no login (SMTP_SECURE=false).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Wholesale Street <info@wholesalestreet.co.uk>"
# Where the team is told about a new trade-account application.
ADMIN_NOTIFY_EMAIL=
# Lets Vercel Cron call /api/cron/emails (any long random string). Without it that route refuses everyone.
CRON_SECRET=

# --- Tests only ---
# Postgres URL for SQL security tests against the local stack.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PW_CHROMIUM=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
